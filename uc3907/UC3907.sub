

.subckt UC3907 CSP CSM SHARE ADJ GND params: VCC_MODEL=12 C_ADJ=1u
.param CS_GAIN=19.6 CS_OFFSET=0.25 CS_TAU=1u
.param BUS_R=10 BUS_OFFSET=5m BUS_IMAX=15m
.param ADJ_GM=3m ADJ_RO=593k ADJ_LO=1.15 ADJ_HI=2.9
.param SHARE_OFFSET=50m ADJ_MAX=0.1 ADJ_RATIO=17.5


BCST cst GND V={max(0,min(max(0,VCC_MODEL-0.5),
+ CS_OFFSET+CS_GAIN*V(CSP,CSM)))}
RCS cst cs 1k
CCS cs GND {CS_TAU/1k}


BBIAS busbias GND V={CS_OFFSET}
BBUS GND SHARE I={min(BUS_IMAX,
+ max(0,(V(cs,SHARE)+BUS_OFFSET)/BUS_R))}
RBUS SHARE busbias 10k

BADJ GND adjraw I={min(200u,max(-135u,
+ ADJ_GM*(V(SHARE,cs)-SHARE_OFFSET)))}
BABI abias GND V={ADJ_LO}
RADJ adjraw abias {ADJ_RO}
CADJ adjraw GND {C_ADJ}

BACL adjraw GND I={max(0,V(adjraw,GND)-ADJ_HI)
+ -max(0,ADJ_LO-V(adjraw,GND))}


BOUT ADJ GND V={min(ADJ_MAX,
+ max(0,(V(adjraw,GND)-ADJ_LO)/ADJ_RATIO))}
.ends UC3907
